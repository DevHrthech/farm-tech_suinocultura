generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Projeto {
  idProjeto   String @id @map("id_projeto")
  nomeProjeto String @map("nome_projeto")

  users              User[]
  courses            Course[]
  lessons            Lesson[]
  progress           LessonProgress[]
  quizzes            Quiz[]
  quizQuestions      QuizQuestion[]
  quizAttempts       QuizAttempt[]
  instructorRequests InstructorRequest[]
  notifications      Notification[]

  @@map("projeto")
}

model User {
  id           String   @id
  nomeCompleto String   @map("nome_completo")
  email        String   @unique
  passwordHash String   @map("password_hash")
  role         String   @default("admin")
  isActive     Boolean  @default(true) @map("is_active")
  avatarUrl    String?  @map("avatar_url")
  tenantId     String   @default("tenant-1") @map("tenant_id")
  idProjeto    String   @default("5119fe85-1f7e-44d3-b50c-fbf97e64c33c") @map("id_projeto")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  projeto           Projeto             @relation(fields: [idProjeto], references: [idProjeto])
  courses           Course[]            @relation("CourseAuthor")
  progress          LessonProgress[]
  quizAttempts      QuizAttempt[]
  instructorRequest InstructorRequest?
  notifications     Notification[]

  @@map("users")
}

model Course {
  id          String   @id
  title       String
  category    String
  description String
  authorId    String   @map("author_id")
  tenantId    String   @default("tenant-1") @map("tenant_id")
  idProjeto   String   @default("5119fe85-1f7e-44d3-b50c-fbf97e64c33c") @map("id_projeto")
  coverImageUrl String? @map("cover_image_url")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  author        User           @relation("CourseAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  projeto       Projeto        @relation(fields: [idProjeto], references: [idProjeto])
  lessons       Lesson[]
  quizzes       Quiz[]
  quizQuestions QuizQuestion[]
  quizAttempts  QuizAttempt[]

  @@map("courses")
}

model Lesson {
  id          String   @id
  title       String
  description String
  videoId     String   @map("video_id")
  lessonOrder Int      @map("lesson_order")
  courseId    String   @map("course_id")
  tenantId    String   @default("tenant-1") @map("tenant_id")
  idProjeto   String   @default("5119fe85-1f7e-44d3-b50c-fbf97e64c33c") @map("id_projeto")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  course  Course  @relation(fields: [courseId], references: [id], onDelete: Cascade)
  projeto Projeto @relation(fields: [idProjeto], references: [idProjeto])
  progress LessonProgress[]

  @@map("lessons")
}

model LessonProgress {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  lessonId  String    @map("lesson_id")
  completed Boolean   @default(false)
  watchedAt DateTime? @map("watched_at")
  tenantId  String    @default("tenant-1") @map("tenant_id")
  idProjeto String    @default("5119fe85-1f7e-44d3-b50c-fbf97e64c33c") @map("id_projeto")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson  Lesson  @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  projeto Projeto @relation(fields: [idProjeto], references: [idProjeto])

  @@unique([userId, lessonId])
  @@map("lesson_progress")
}

model Quiz {
  id          String   @id @default(uuid())
  courseId    String   @map("course_id")
  title       String
  description String?
  tenantId    String   @default("tenant-1") @map("tenant_id")
  idProjeto   String   @default("5119fe85-1f7e-44d3-b50c-fbf97e64c33c") @map("id_projeto")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  course    Course         @relation(fields: [courseId], references: [id], onDelete: Cascade)
  projeto   Projeto        @relation(fields: [idProjeto], references: [idProjeto])
  questions QuizQuestion[]
  attempts  QuizAttempt[]

  @@map("quizzes")
}

model QuizQuestion {
  id            String   @id @default(uuid())
  courseId      String   @map("course_id")
  quizId        String   @map("quiz_id")
  text          String
  options       Json
  correctIndex  Int      @map("correct_index")
  explanation   String?
  questionOrder Int      @map("question_order")
  tenantId      String   @default("tenant-1") @map("tenant_id")
  idProjeto     String   @default("5119fe85-1f7e-44d3-b50c-fbf97e64c33c") @map("id_projeto")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  course  Course  @relation(fields: [courseId], references: [id], onDelete: Cascade)
  quiz    Quiz    @relation(fields: [quizId], references: [id], onDelete: Cascade)
  projeto Projeto @relation(fields: [idProjeto], references: [idProjeto])

  @@map("quiz_questions")
}

model QuizAttempt {
  id          String   @id @default(uuid())
  userId      String   @map("user_id")
  courseId    String   @map("course_id")
  quizId      String?  @map("quiz_id")
  score       Int
  total       Int
  tenantId    String   @default("tenant-1") @map("tenant_id")
  idProjeto   String   @default("5119fe85-1f7e-44d3-b50c-fbf97e64c33c") @map("id_projeto")
  completedAt DateTime @default(now()) @map("completed_at")

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  course  Course  @relation(fields: [courseId], references: [id], onDelete: Cascade)
  quiz    Quiz?   @relation(fields: [quizId], references: [id], onDelete: SetNull)
  projeto Projeto @relation(fields: [idProjeto], references: [idProjeto])

  @@map("quiz_attempts")
}

model InstructorRequest {
  id         String    @id @default(uuid())
  userId     String    @unique @map("user_id")
  status     String    @default("pending")
  reviewedBy String?   @map("reviewed_by")
  reviewedAt DateTime? @map("reviewed_at")
  tenantId   String    @default("tenant-1") @map("tenant_id")
  idProjeto  String    @default("5119fe85-1f7e-44d3-b50c-fbf97e64c33c") @map("id_projeto")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  projeto Projeto @relation(fields: [idProjeto], references: [idProjeto])

  @@map("instructor_requests")
}

model Notification {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  type      String
  message   String
  link      String?
  read      Boolean  @default(false)
  tenantId  String   @default("tenant-1") @map("tenant_id")
  idProjeto String   @default("5119fe85-1f7e-44d3-b50c-fbf97e64c33c") @map("id_projeto")
  createdAt DateTime @default(now()) @map("created_at")

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  projeto Projeto @relation(fields: [idProjeto], references: [idProjeto])

  @@map("notifications")
}